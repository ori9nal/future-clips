# Copy to .env.local (git-ignored). Never commit real values.

# ── engine (tools/make-set.mjs) ──────────────────────────────────────────
OPENAI_API_KEY=            # required for art=ai and style=bedrock — platform.openai.com/api-keys, needs image model access
OPENAI_IMAGE_MODEL=gpt-image-2   # optional, defaults to gpt-image-2
ANTHROPIC_API_KEY=         # required for every set (copy + compliance loop) — console.anthropic.com, key must be workspace-scoped

# ── site (app/) ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
FC_ADMIN_SECRET=           # gates /admin and /api/ingest

# ── superseded sourcing layer (engine/_attic/source) — not needed ────────
PEXELS_API_KEY=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=
UNSPLASH_APP_ID=
APIFY_TOKEN=
