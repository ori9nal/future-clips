# Copy to .env.local (git-ignored). Never commit real values.

# ── Supabase (project clipcarousel, waipwmyncpsgoglmkhdz) ────────────────
NEXT_PUBLIC_SUPABASE_URL=https://waipwmyncpsgoglmkhdz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=        # publishable key (sb_publishable_...) — safe in the browser, RLS is the control
SUPABASE_SERVICE_ROLE_KEY=            # SERVER ONLY. The worker, Storage writes, the quota gate, the billing webhook.
                                      # Never NEXT_PUBLIC_, never in a client component (lib/supabase/admin.ts is server-only).

# ── engine (tools/make-set.mjs and the hosted worker) ─────────────────────
OPENAI_API_KEY=                       # gpt-image-2 access — platform.openai.com/api-keys
OPENAI_IMAGE_MODEL=gpt-image-2        # optional
OPENAI_INPUT_IMAGES_PER_MIN=5         # the org's "input-images per min" limit for edits with a reference; raise with the tier
ANTHROPIC_API_KEY=                    # workspace-scoped key — console.anthropic.com

# ── app ───────────────────────────────────────────────────────────────────
CRON_SECRET=                          # Vercel sends it as a bearer token to /api/cron/lanes and /api/keepalive; the poller refuses to run without it
NEXT_PUBLIC_GOOGLE_AUTH=0             # 1 once the Google OAuth client is configured in Supabase Auth

# ── billing (Dodo Payments; everything stays inert until DODO_API_KEY is set) ──
DODO_API_KEY=                         # SERVER ONLY
DODO_WEBHOOK_SECRET=                  # SERVER ONLY, whsec_…
DODO_ENV=test                         # test | live
DODO_PRODUCTS=                        # solo=pdt_…,grind=pdt_…,agency=pdt_…,p100=pdt_…,p250=pdt_…,p600=pdt_…

# ── development only (a no-op in production) ───────────────────────────────
# FC_DEMO_PREVIEW=1                   # /design-preview renders the dashboards on fixtures with no session
# FC_HIDE_DEV_BADGE=1                 # no Next dev indicator (screenshots from `next dev`)
# FC_DEMO_SETS=1                      # sets rendered on this machine (output/sets/*-priority|batch) show as finished
# FC_DEMO_PLAN=grind                  # the dashboard shows this plan
# FC_DEMO_PARTNERS=1  FC_DEMO_PARTNER=1   # sample referral data / the partner dashboard (dormant features)
# FC_REFERRALS=1                      # the webhook records referral commissions (dormant; needs migration 0005)
