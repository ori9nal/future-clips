{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stack",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "(python3 -m http.server 3323 --bind 127.0.0.1 --directory future-clips-site >/dev/null 2>&1 &) ; FC_SITE_PROXY=http://127.0.0.1:3323 FC_DEV_LOGIN=1 FC_DEMO_GENERATE=1 FC_DEMO_PREVIEW=1 FC_HIDE_DEV_BADGE=1 npx next dev -p 3000"
      ],
      "port": 3000
    },
    {
      "name": "future-clips",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "site",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "3323",
        "--bind",
        "127.0.0.1",
        "--directory",
        "future-clips-site"
      ],
      "port": 3323
    },
    {
      "name": "future-clips-product",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd ../fc-product && FC_DEMO_PREVIEW=1 npx next dev -p 3001"
      ],
      "port": 3001
    },
    {
      "name": "future-clips-preview",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "FC_DEMO_PREVIEW=1 FC_HIDE_DEV_BADGE=1 npx next dev -p 3002"
      ],
      "port": 3002
    },
    {
      "name": "future-clips-prod",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "next",
        "start",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "dodo-sim",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "set -a; . ./.env.local; set +a; APP=http://127.0.0.1:3100 node tools/dodo-sim.mjs"
      ],
      "port": 3400
    }
  ]
}
