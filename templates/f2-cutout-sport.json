{
  "id": "f2-cutout-sport",
  "name": "CUTOUT-SPORT",
  "reference": "corpus folder 13 — pure white, expanded grotesk 800 italic, accent on the larger line, cutout crosses the headline cap-height",
  "canvas": { "w": 1080, "h": 1440 },
  "safe": { "top": 90, "bottom": 150, "left": 76, "right": 76 },
  "slideCount": [7, 10],
  "hookTypes": ["side-effect", "confession-receipt", "numbered-authority", "lazy-effortless"],
  "cropStrategies": ["contain"],

  "roles": {
    "cover": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "subject": {
        "pool": ["stand-slump", "sit-edge", "sit-phone"], "rotate": false,
        "grade": "duotone", "shadow": "ink", "highlight": "#C9CDD6",
        "heightPct": 0.52, "anchor": "bottom-right", "dx": 30, "dy": -430
      },
      "type": [
        {
          "id": "headline", "content": "stack2", "mode": "lines",
          "box": { "x": "safe.left", "y": 760, "w": "safe.width", "h": 330 },
          "size": [64, 132],
          "font": { "role": "display-sport", "weight": 800, "style": "italic" },
          "lineHeight": 0.9, "tracking": -0.024,
          "align": "left", "valign": "bottom", "color": "ink",
          "accent": { "target": "line:1", "color": "accent" }
        },
        {
          "id": "kicker", "content": "kicker",
          "box": { "x": "safe.left", "y": { "after": "headline", "gap": 20 }, "w": 800, "h": 96 },
          "size": [28, 44], "maxLines": 2,
          "font": { "role": "display-sport", "weight": 700, "style": "italic" },
          "lineHeight": 1.22, "align": "left", "valign": "top", "color": "ink"
        }
      ]
    },

    "body": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "subject": {
        "pool": ["hypnogram", "dial-62", "bed", "dial-91", "moon"],
        "grade": "none", "heightPct": 0.2,
        "anchor": "bottom-right", "dx": 40, "dy": -170, "opacity": 0.95
      },
      "type": [
        {
          "id": "headline", "content": "title",
          "box": { "x": "safe.left", "y": 168, "w": 860, "h": 250 },
          "size": [48, 92], "maxLines": 2,
          "font": { "role": "display-sport", "weight": 800, "style": "italic" },
          "lineHeight": 0.95, "tracking": -0.022,
          "align": "left", "valign": "top", "color": "ink",
          "accent": { "target": "last-word", "color": "accent" }
        },
        {
          "id": "claim", "content": "claim",
          "box": { "x": "safe.left", "y": { "after": "headline", "gap": 42 }, "w": 800, "h": 170 },
          "size": [30, 46], "maxLines": 3,
          "font": { "role": "body", "weight": 700, "style": "italic" },
          "lineHeight": 1.24, "align": "left", "valign": "top", "color": "ink"
        },
        {
          "id": "body", "content": "body",
          "box": {
            "x": "safe.left", "y": { "after": "claim", "gap": 36 }, "w": 730,
            "h": { "remaining": "claim", "until": 1140, "gap": 36 }
          },
          "size": [26, 40], "maxLines": 8,
          "font": { "role": "body", "weight": 400, "style": "italic" },
          "lineHeight": 1.44, "align": "left", "valign": "top", "color": "ink-soft"
        }
      ]
    },

    "closer": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "subject": null,
      "type": [
        {
          "id": "headline", "content": "headline",
          "box": { "x": 100, "y": 540, "w": 880, "h": 220 },
          "size": [58, 104], "maxLines": 2,
          "font": { "role": "display-sport", "weight": 800, "style": "italic" },
          "lineHeight": 0.96, "tracking": -0.022,
          "align": "center", "valign": "top", "color": "ink",
          "accent": { "target": "manual", "from": "accentWord", "color": "accent" }
        },
        {
          "id": "kicker", "content": "kicker",
          "box": { "x": 140, "y": { "after": "headline", "gap": 28 }, "w": 800, "h": 110 },
          "size": [26, 40], "maxLines": 2,
          "font": { "role": "body", "weight": 400, "style": "italic" },
          "lineHeight": 1.3, "align": "center", "valign": "top", "color": "ink-soft"
        }
      ]
    }
  },

  "furniture": [
    { "type": "handle", "anchor": "bottom-left", "gap": 26, "size": 26,
      "font": { "role": "body", "weight": 600 }, "color": "ink" },
    { "type": "arrow", "anchor": "bottom-right", "gap": 14, "size": 44, "glyph": "→",
      "font": { "role": "body", "weight": 400 }, "color": "ink", "on": ["cover", "body"] },
    { "type": "index", "anchor": "bottom-center", "gap": 28, "size": 24, "tracking": 0.12,
      "format": "{i} / {n}", "font": { "role": "mono", "weight": 500 }, "color": "ink-soft", "on": ["body"] },
    { "type": "wordmark", "anchor": "top-left", "gap": 6, "size": 26, "tracking": 0.26,
      "font": { "role": "body", "weight": 800 }, "color": "ink", "on": ["cover", "closer"],
      "dot": { "r": 6, "gap": 0, "color": "accent" } }
  ]
}
