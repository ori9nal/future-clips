{
  "id": "f4-type-mono",
  "name": "TYPE-MONO",
  "reference": "corpus folder 4, @whymattrs — pure white, monospace only, centred, index+title in grey, handle bottom-centre at exactly 115px, zero imagery",
  "canvas": { "w": 1080, "h": 1440 },
  "safe": { "top": 120, "bottom": 150, "left": 118, "right": 118 },
  "slideCount": [6, 8],
  "hookTypes": ["numbered-authority", "contrarian-negation", "confession-receipt"],
  "cropStrategies": ["contain"],

  "roles": {
    "cover": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "subject": null,
      "type": [
        {
          "id": "eyebrow", "content": "eyebrow",
          "box": { "x": "safe.left", "y": 300, "w": "safe.width", "h": 44 },
          "size": [18, 26], "maxLines": 1,
          "font": { "role": "mono", "weight": 400 },
          "lineHeight": 1.2, "tracking": 0.24,
          "align": "center", "valign": "top", "color": "ink-soft"
        },
        {
          "id": "headline", "content": "headline",
          "box": { "x": "safe.left", "y": { "after": "eyebrow", "gap": 92 }, "w": "safe.width", "h": 400 },
          "size": [40, 78], "maxLines": 4,
          "font": { "role": "mono", "weight": 500 },
          "lineHeight": 1.34, "tracking": -0.01,
          "align": "center", "valign": "top", "color": "ink",
          "accent": { "target": "manual", "from": "accentWord", "color": "accent" }
        },
        {
          "id": "kicker", "content": "kicker",
          "box": { "x": 190, "y": { "after": "headline", "gap": 66 }, "w": 700, "h": 120 },
          "size": [22, 32], "maxLines": 3,
          "font": { "role": "mono", "weight": 400 },
          "lineHeight": 1.44, "align": "center", "valign": "top", "color": "ink-soft"
        }
      ]
    },

    "body": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "subject": null,
      "type": [
        {
          "id": "headline", "content": "eyebrow",
          "box": { "x": "safe.left", "y": 380, "w": "safe.width", "h": 60 },
          "size": [24, 38], "maxLines": 1,
          "font": { "role": "mono", "weight": 500 },
          "lineHeight": 1.24, "tracking": 0.06,
          "align": "center", "valign": "top", "color": "ink-soft"
        },
        {
          "id": "claim", "content": "claim",
          "box": { "x": "safe.left", "y": { "after": "headline", "gap": 60 }, "w": "safe.width", "h": 230 },
          "size": [26, 42], "maxLines": 4,
          "font": { "role": "mono", "weight": 500 },
          "lineHeight": 1.38, "align": "center", "valign": "top", "color": "ink"
        },
        {
          "id": "body", "content": "body",
          "box": { "x": 150, "y": { "after": "claim", "gap": 62 }, "w": 780, "h": 350 },
          "size": [20, 30], "maxLines": 9,
          "font": { "role": "mono", "weight": 400 },
          "lineHeight": 1.56, "align": "center", "valign": "top", "color": "ink-soft"
        },
        {
          "id": "stat", "content": "stat", "optional": true,
          "box": { "x": "safe.left", "y": { "after": "body", "gap": 54 }, "w": "safe.width", "h": 60 },
          "size": [22, 34], "maxLines": 1,
          "font": { "role": "mono", "weight": 700 },
          "lineHeight": 1.2, "tracking": 0.1,
          "align": "center", "valign": "top", "color": "accent"
        }
      ]
    },

    "closer": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "subject": null,
      "type": [
        {
          "id": "headline", "content": "headline",
          "box": { "x": "safe.left", "y": 640, "w": "safe.width", "h": 110 },
          "size": [30, 52], "maxLines": 2,
          "font": { "role": "mono", "weight": 500 },
          "lineHeight": 1.3, "align": "center", "valign": "top", "color": "ink",
          "accent": { "target": "manual", "from": "accentWord", "color": "accent" }
        },
        {
          "id": "kicker", "content": "kicker",
          "box": { "x": 190, "y": { "after": "headline", "gap": 40 }, "w": 700, "h": 96 },
          "size": [20, 28], "maxLines": 2,
          "font": { "role": "mono", "weight": 400 },
          "lineHeight": 1.44, "align": "center", "valign": "top", "color": "ink-soft"
        }
      ]
    }
  },

  "rules": [
    { "on": ["cover"], "x": 470, "y": 372, "w": 140, "h": 2, "color": "ink-soft", "opacity": 0.5 }
  ],

  "furniture": [
    { "type": "handle", "anchor": "bottom-center", "gap": 44, "size": 24,
      "font": { "role": "mono", "weight": 400 }, "color": "ink-soft" },
    { "type": "wordmark", "anchor": "top-center", "gap": 12, "size": 22, "tracking": 0.36,
      "font": { "role": "mono", "weight": 700 }, "color": "ink", "on": ["cover", "closer"] },
    { "type": "index", "anchor": "top-center", "gap": 12, "size": 20, "tracking": 0.2,
      "format": "{i} / {n}", "font": { "role": "mono", "weight": 400 }, "color": "ink-soft", "on": ["body"] }
  ]
}
