{
  "id": "f3-statement",
  "name": "STATEMENT",
  "reference": "corpus folder 3's interiors — no imagery whatsoever. A block of plain sans set mid-frame with a 460px top margin, short paragraphs, generous leading. 89% of the reference corpus is a flat plate and a lot of it carries no picture at all; a set that fills every frame reads as relentless.",
  "canvas": { "w": 1080, "h": 1440 },
  "safe": { "top": 96, "bottom": 128, "left": 132, "right": 132 },
  "slideCount": [6, 9],
  "hookTypes": ["reframe", "contrast", "list", "prescription"],
  "cropStrategies": ["contain"],
  "hierarchyRatio": 0.62,

  "roles": {
    "cover": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "type": [
        {
          "id": "headline",
          "content": "headline",
          "box": { "x": "safe.left", "y": 300, "w": 816, "h": 560 },
          "size": [70, 116],
          "maxLines": 5,
          "font": { "role": "body", "weight": 400 },
          "lineHeight": 1.14,
          "tracking": -0.014,
          "align": "left",
          "valign": "top",
          "color": "ink",
          "hierarchy": "display",
          "lowercase": true
        }
      ]
    },

    "body": {
      "_note": "The corpus geometry: a text block starting around a third of the way down, never at the top, with air above and below it.",
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "type": [
        {
          "id": "headline",
          "content": "title",
          "box": { "x": "safe.left", "y": 420, "w": 816, "h": 300 },
          "size": [44, 66],
          "maxLines": 4,
          "font": { "role": "body", "weight": 500 },
          "lineHeight": 1.2,
          "tracking": -0.006,
          "align": "left",
          "valign": "top",
          "color": "ink",
          "hierarchy": "display",
          "lowercase": true
        },
        {
          "id": "body",
          "content": "body",
          "optional": true,
          "box": { "x": "safe.left", "y": { "after": "headline", "gap": 40 }, "w": 816, "h": 320 },
          "size": [28, 38],
          "maxLines": 8,
          "font": { "role": "body", "weight": 400 },
          "lineHeight": 1.52,
          "align": "left",
          "valign": "top",
          "color": "ink-soft",
          "lowercase": true
        }
      ]
    },

    "body-numbered": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "type": [
        {
          "id": "index",
          "content": "indexDot",
          "box": { "x": "safe.left", "y": 330, "w": 300, "h": 140 },
          "size": [96, 148],
          "maxLines": 1,
          "font": { "role": "body", "weight": 400 },
          "lineHeight": 1.0,
          "align": "left",
          "valign": "top",
          "color": "ink-soft"
        },
        {
          "id": "headline",
          "content": "title",
          "box": { "x": "safe.left", "y": { "after": "index", "gap": 30 }, "w": 816, "h": 300 },
          "size": [44, 70],
          "maxLines": 4,
          "font": { "role": "body", "weight": 500 },
          "lineHeight": 1.18,
          "align": "left",
          "valign": "top",
          "color": "ink",
          "hierarchy": "display",
          "lowercase": true
        },
        {
          "id": "body",
          "content": "body",
          "optional": true,
          "box": { "x": "safe.left", "y": { "after": "headline", "gap": 34 }, "w": 760, "h": 260 },
          "size": [27, 35],
          "maxLines": 6,
          "font": { "role": "body", "weight": 400 },
          "lineHeight": 1.5,
          "align": "left",
          "valign": "top",
          "color": "ink-soft",
          "lowercase": true
        }
      ]
    },

    "closer": {
      "background": { "type": "flat", "fill": "#FFFFFF" },
      "type": [
        {
          "id": "headline",
          "content": "headline",
          "box": { "x": "safe.left", "y": 520, "w": 816, "h": 330 },
          "size": [62, 100],
          "maxLines": 3,
          "font": { "role": "body", "weight": 400 },
          "lineHeight": 1.14,
          "tracking": -0.012,
          "align": "left",
          "valign": "top",
          "color": "ink",
          "hierarchy": "display",
          "lowercase": true
        },
        {
          "id": "kicker",
          "content": "kicker",
          "optional": true,
          "box": { "x": "safe.left", "y": { "after": "headline", "gap": 28 }, "w": 700, "h": 120 },
          "size": [25, 33],
          "maxLines": 2,
          "font": { "role": "body", "weight": 400 },
          "lineHeight": 1.46,
          "align": "left",
          "valign": "top",
          "color": "ink-soft",
          "lowercase": true
        }
      ]
    }
  },

  "furniture": [
    { "type": "handle", "anchor": "bottom-left", "gap": 20, "size": 25,
      "font": { "role": "mono", "weight": 400 }, "color": "ink" },
    { "type": "arrow", "anchor": "bottom-right", "gap": 10, "size": 38, "glyph": "→",
      "font": { "role": "body", "weight": 400 }, "color": "ink", "on": ["cover", "body", "body-numbered"] }
  ],

  "bodyVariants": ["body-numbered", "body", "body-numbered", "body"]
}
